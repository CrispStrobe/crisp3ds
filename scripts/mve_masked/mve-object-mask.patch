+inline bool
+SingleView::validPixel(int x, int y, int level) const
+{
+    ImagePyramidLevel const& l = this->img_pyramid->at(level);
+    if (x < 0 || y < 0 || x >= l.width || y >= l.height)
+        return false;
+    return l.valid == nullptr || l.valid->at(y * l.width + x) == 255;
+}
+
+inline bool
+SingleView::validSample(float x, float y, int level) const
+{
+    if (!std::isfinite(x) || !std::isfinite(y))
+        return false;
+    int left = static_cast<int>(std::floor(x));
+    int top = static_cast<int>(std::floor(y));
+    return validPixel(left, top, level) && validPixel(left + 1, top, level)
+        && validPixel(left, top + 1, level) && validPixel(left + 1, top + 1, level);
+}
+
+inline bool
+SingleView::validScaledPixel(int x, int y) const
+{
+    return this->target_level.valid == nullptr
+        || (x >= 0 && y >= 0 && x < this->target_level.width
+            && y < this->target_level.height
+            && this->target_level.valid->at(y * this->target_level.width + x) == 255);
+}
