<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac App Store and TestFlight builds must be sandboxed. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Inputs are folders the user picks; runs can be written to a folder the user picks. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Outgoing connections only, for the optional engine on another computer. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
